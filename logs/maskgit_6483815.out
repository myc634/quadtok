[12/02 04:52:40 TiTok-Gen]: Config:
experiment:
  project: dynamic_tokenizer_generation
  name: maskgit_quadtree_fixtree
  output_dir: checkpoints/generator/maskgit_quadtree_fixtree
  max_train_examples: 1281167
  save_every: 10000
  eval_every: 50000
  generate_every: 1000
  log_every: 50
  log_grad_norm_every: 1000
  resume: false
  logging_dir: checkpoints/generator/maskgit_quadtree_fixtree/logs
tokenizer:
  type: quadtok
  tokenizer_ckpt_dir: /mnt/petrelfs/jianglihan/my_code/quadtok/checkpoints/quadtok_sl256_vq_ts8-expandprob34/checkpoint-250000/ema_model/pytorch_model.bin
  vae_embed_dim: 8
model:
  type: quadtok
  grad_checkpointing: true
  vq_model:
    quantize_mode: vq
    vit_enc_model_size: small
    vit_dec_model_size: small
    vit_enc_patch_size: 16
    vit_dec_patch_size: 16
    decoder_token_size: 256
    codebook_size: 16384
    use_l2_norm: true
    commitment_cost: 0.25
    token_size: 8
  selector:
    token_size: 8
    num_patch_side_list:
    - 1
    - 2
    - 4
    - 8
    - 16
    - 32
    patch_size_list:
    - 16
    - 16
    - 16
    - 16
    - 16
    - 8
  generator_type: maskgit
  generator:
    model_type: ViT
    hidden_size: 768
    num_hidden_layers: 24
    num_attention_heads: 16
    intermediate_size: 3072
    dropout: 0.1
    attn_drop: 0.1
    class_label_dropout: 0.1
    image_seq_len: 261
    condition_num_classes: 1000
    num_steps: 16
    randomize_temperature: 2.5
    guidance_scale: 8.5
    guidance_decay: power-cosine
losses:
  label_smoothing: 0.1
  loss_weight_unmasked_token: 0.0
dataset:
  type: simple_image
  params:
    train_shards_path_or_url: pipe:rclone cat hoss:jianglihan/data/imagenet/imagenet-train-{000000..000070}.tar
    eval_shards_path_or_url: pipe:rclone cat hoss:jianglihan/data/imagenet/imagenet-val-{000000..000049}.tar
    num_workers_per_gpu: 12
  preprocessing:
    resize_shorter_edge: 256
    crop_size: 256
    random_crop: true
    random_flip: true
    res_ratio_filtering: true
optimizer:
  name: adamw
  params:
    learning_rate: 0.0001
    beta1: 0.9
    beta2: 0.96
    weight_decay: 0.03
lr_scheduler:
  scheduler: cosine
  params:
    learning_rate: ${optimizer.params.learning_rate}
    warmup_steps: 10000
    end_lr: 1.0e-05
training:
  gradient_accumulation_steps: 1
  per_gpu_batch_size: 64
  mixed_precision: bf16
  enable_tf32: true
  enable_wandb: true
  use_ema: true
  seed: 42
  max_train_steps: 1000000
  max_grad_norm: 1.0
config: configs/training/generator/maskgit_quadtree_fixtree.yaml

